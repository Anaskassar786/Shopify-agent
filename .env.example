# ─── PROFIT TOOL AI — environment template ────────────────────────────────────
# Copy to each app's env location (e.g. apps/api/.env). NEVER commit real values.
# Per-environment files are managed by the hosting platform (Railway variables)
# in staging/production; .env files are for local development only.

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Database (local: docker compose up -d postgres)
DATABASE_URL=postgres://profit:profit@localhost:5432/profit_tool_ai

# Redis (queue, cache, rate limiting) — local: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Shopify app credentials (from the Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,write_discounts,read_price_rules,read_draft_orders,write_draft_orders,read_fulfillments,read_locations,read_content

# AI — primary provider (adapters for other providers plug into the same port)
GEMINI_API_KEY=
AI_DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# Auth tokens (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=

# At-rest encryption for stored secrets such as Shopify offline tokens
# 32 bytes, hex- or base64-encoded.
ENCRYPTION_KEY=

# Billing
SHOPIFY_BILLING_PLAN=starter

# Email (SMTP baseline; EmailProvider port supports swapping providers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@profittool.ai

# Webhooks
WEBHOOK_SECRET=

# Observability
SENTRY_DSN=

# Embedded web app (M3)
# The API serves the built web bundle (dist index.html with %SHOPIFY_API_KEY%
# injected at serve time). Relative to apps/api; Railway sets it to the
# workspace-root apps/web/dist via monorepo build.
WEB_DIST_DIR=../web/dist
# Local web dev server only: proxies /api and /shopify to the running API so
# the browser never talks to a second origin.
API_PROXY_TARGET=http://localhost:3000
LOG_LEVEL=info

# ─── Worker service (apps/worker; set in the worker's own env) ───────────────
# Health endpoint port: the worker reads PORT too; run the two services with
# separate envs (API: PORT=3000, worker: PORT=3100 — the worker's default).
PORT=3100
# BullMQ consumer concurrency per queue.
WORKER_CONCURRENCY=8
# Scheduled incremental-sync cadence (min 60_000).
SYNC_INCREMENTAL_INTERVAL_MS=3600000
# Analytics pre-aggregation cadence (min 300_000).
ANALYTICS_REFRESH_INTERVAL_MS=21600000
# Shopify HTTP transport retry budget (429/5xx/backoff) for sync + webhooks.
SHOPIFY_HTTP_MAX_RETRIES=6
SHOPIFY_HTTP_BASE_DELAY_MS=250

# M4 AI engine (worker): scheduled analysis cadence per store (min 1h, default 6h)
AI_RUN_INTERVAL_MS=21600000
# Attribution measurement sweep cadence (min 1h, default 24h)
AI_MEASURE_INTERVAL_MS=86400000
# Hard cap on paid model calls per analysis run — the cost circuit breaker (1–10)
AI_MAX_AGENT_CALLS_PER_RUN=5

# ─── M5: billing + growth plane ─────────────────────────────────────────────
# API: when "true", Shopify recurring charges are created in test mode (dev
# stores / staging). NEVER true in production — real merchants get real charges.
SHOPIFY_BILLING_TEST=false
# API: key-gates the read-only platform-admin API (/api/v1/admin/*). Required
# for the Super Admin console (/admin). Keep it long, random, and out of git.
PLATFORM_ADMIN_KEY=
# Worker: trial journey (D1/D2/D3 nudges + expiry) cadence (min 30 min, default 1h)
TRIAL_LIFECYCLE_INTERVAL_MS=3600000
# Worker: convergent usage-rollup cadence into usage_records (min 30 min, default 1h)
USAGE_ROLLUP_INTERVAL_MS=3600000
# Worker: Shopify charge reconcile sweep cadence (min 1h, default 24h)
BILLING_RECONCILE_INTERVAL_MS=86400000
# Worker: churn-risk scan + re-engagement nudge cadence (min 30 min, default 24h)
CHURN_SCAN_INTERVAL_MS=86400000
# Worker: automation tick — cron fan-out for SCHEDULE workflows, DELAY resume,
# campaign batch sweeps (min 5s, max 1h, default 60s)
AUTOMATION_TICK_INTERVAL_MS=60000
# Worker: campaign send batching — recipients per BullMQ job (1–500, default 50)
CAMPAIGN_SEND_BATCH_SIZE=50
# Worker: delay between campaign batches (0–120s, default 2s)
CAMPAIGN_SEND_THROTTLE_MS=2000
# Worker: Twilio SMS. Leave ALL unset to run without SMS — sends then fail fast
# with a merchant-readable reason instead of silently skipping (deliberate).
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=
# API + Worker: HMAC secret for campaign tracking pixel/click/unsubscribe tokens.
# Must MATCH on both services. Rotating invalidates in-flight links (acceptable).
TRACKING_SIGNING_SECRET=
# Worker: public base URL embedded in tracked links/pixels. Fallback chain:
# TRACKING_PUBLIC_BASE_URL → SHOPIFY_APP_URL → http://localhost:8080. Set to
# the public API origin in production.
TRACKING_PUBLIC_BASE_URL=
# M7 legal plane (REQUIRED in production): the contracting entity named in the
# public ToS/policies, and the published merchant-support email shown on /legal
# pages, the partner directory, and in-app support surfaces.
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
